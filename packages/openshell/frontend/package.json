{
  "name": "openshell-ui",
  "version": "1.0.0",
  "description": "OpenShell standalone frontend UI",
  "repository": "https://github.com/opendatahub-io/odh-dashboard.git",
  "homepage": "https://github.com/opendatahub-io/odh-dashboard",
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "npm@11.8.0",
  "overrides": {
    "js-yaml": "^4.1.1",
    "csstype": "3.2.3",
    "axios": "^1.15.0",
    "shell-quote": ">=1.8.4",
    "@types/react": "18.3.31",
    "dompurify": "^3.4.13"
  },
  "scripts": {
    "build": "run-s build:prod",
    "build:prod": "rspack --config ./config/rspack.prod.js",
    "build:clean": "rm -rf ./dist",
    "start:dev": "rspack dev --hot --config ./config/rspack.dev.js",
    "test": "run-s test:lint test:type-check test:unit",
    "test:jest": "jest",
    "test:unit": "npm run test:jest -- --silent",
    "lint": "eslint --max-warnings 0 --ext .js,.ts,.jsx,.tsx ./src ./*.js",
    "lint:fix": "eslint --ext .js,.ts,.jsx,.tsx ./src ./*.js --fix",
    "test:lint": "eslint --max-warnings 0 --ext .js,.ts,.jsx,.tsx ./src ./*.js && prettier --check ./*.js ./*.cjs ./*.md ../*.md",
    "test:type-check": "tsc --noEmit",
    "start:default": "STYLE_THEME=patternfly-theme npm run start:dev"
  },
  "devDependencies": {
    "@module-federation/enhanced": "^0.24.1",
    "@rsdoctor/rspack-plugin": "^1.6.1",
    "@rspack/cli": "2.1.10",
    "@rspack/core": "2.1.10",
    "@rspack/dev-server": "^2.1.0",
    "@rspack/plugin-react-refresh": "^2.0.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.2",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "14.6.1",
    "@types/jest": "^30.0.0",
    "@types/react-dom": "^18.3.1",
    "core-js": "^3.40.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.4",
    "dotenv": "^16.5.0",
    "dotenv-expand": "^5.1.0",
    "dotenv-webpack": "^8.1.1",
    "expect": "^30.4.1",
    "file-loader": "^6.2.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "raw-loader": "^4.0.2",
    "react-refresh": "^0.14.2",
    "regenerator-runtime": "^0.14.1",
    "rspack-merge": "^1.0.1",
    "sass": "^1.87.0",
    "sass-loader": "^16.0.7",
    "style-loader": "^4.0.0",
    "svg-url-loader": "^8.0.0",
    "ts-checker-rspack-plugin": "^1.5.3",
    "tslib": "^2.7.0",
    "typescript": "^5.8.2",
    "url-loader": "^4.1.1",
    "webpack": "5.104.1"
  },
  "dependencies": {
    "@patternfly/patternfly": "~6.5.1",
    "@patternfly/react-core": "~6.5.1",
    "@patternfly/react-icons": "~6.5.1",
    "@patternfly/react-styles": "~6.5.1",
    "@patternfly/react-table": "~6.5.1",
    "@patternfly/react-templates": "~6.5.1",
    "classnames": "^2.2.6",
    "lodash-es": "^4.17.15",
    "mod-arch-core": "^1.2.2",
    "react": "^18",
    "react-dom": "^18",
    "react-router": "^7.16.0",
    "react-router-dom": "^7.16.0"
  },
  "optionalDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-node": "^0.3.7",
    "eslint-import-resolver-typescript": "^3.8.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-no-only-tests": "^3.1.0",
    "eslint-plugin-no-relative-import-paths": "^1.6.1",
    "eslint-plugin-prettier": "^5.4.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-markdown": "^3.0.1",
    "npm-run-all": "^4.1.5",
    "ts-jest": "^29.4.5"
  }
}
